<Window x:Class="RadialConvert.ImageOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RadialConvert"
        mc:Ignorable="d"
        Title="Organizar páginas del PDF"
        Width="800" Height="470"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <DropShadowEffect x:Key="ModalDropShadow"
                          BlurRadius="32"
                          ShadowDepth="6"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.55"/>

        <DropShadowEffect x:Key="TextReadShadow"
                          BlurRadius="4"
                          ShadowDepth="1"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.7"/>

        <!-- Bisel especular estilo Liquid Glass -->
        <LinearGradientBrush x:Key="SpecularBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B3FFFFFF" Offset="0.0"/>
            <GradientStop Color="#59FFFFFF" Offset="0.5"/>
            <GradientStop Color="#26FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Estilo de botones pequeños de control (▲, ▼, ✕) -->
        <Style x:Key="MiniGlassActionBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#66FFFFFF"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#88FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botones inferiores ("Cancelar" y "Crear PDF") -->
        <Style x:Key="FooterGlassButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FooterBtnBorder"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Effect="{StaticResource TextReadShadow}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterBtnBorder" Property="BorderBrush" Value="#FFFFFFFF"/>
                                <Setter TargetName="FooterBtnBorder" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FooterBtnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón flotante circular sobre las tarjetas (✕, ◀, ▶) -->
        <Style x:Key="CardFloatBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#8C000000"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FloatBorder"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FloatBorder" Property="Background" Value="#CC000000"/>
                                <Setter TargetName="FloatBorder" Property="BorderBrush" Value="#99FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FloatBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="MarginAccentBrush" Color="#FFEC4899"/>

        <Style x:Key="MarginPillStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Height="28"
                                CornerRadius="9"
                                Padding="11,0"
                                Margin="1"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource MarginAccentBrush}"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#66FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Contenedor principal con margen para la sombra exterior -->
    <Grid Margin="18">
        <Border x:Name="MainGlassBorder"
                CornerRadius="18"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Background="#E61A1A1E"
                Effect="{StaticResource ModalDropShadow}">

            <Grid Margin="22,18,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado arrastrable -->
                <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📑" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TitleTextBlock"
                                   Text="Organizar páginas del PDF (0 imágenes)"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontWeight="SemiBold"
                                   FontSize="14.5"
                                   Foreground="#FFFFFF"
                                   Effect="{StaticResource TextReadShadow}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="✕"
                            Style="{StaticResource MiniGlassActionBtnStyle}"
                            ToolTip="Cancelar (Esc)"
                            Click="CancelButton_Click"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="Arrastra las páginas o usa las flechas ◀ ▶ al pasar el ratón para cambiar el orden:"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11"
                           Foreground="#CCFFFFFF"
                           Effect="{StaticResource TextReadShadow}"
                           Margin="0,6,0,10"/>

                <!-- Tira horizontal de páginas (carrusel) con Scroll suave y soporte Drag & Drop -->
                <Border x:Name="ListContainerBorder"
                        Grid.Row="2"
                        CornerRadius="14"
                        Background="#4D141016"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        Padding="6">
                    <ScrollViewer x:Name="ImagesScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  PanningMode="HorizontalOnly"
                                  PreviewMouseWheel="ImagesScrollViewer_PreviewMouseWheel">
                        <ItemsControl x:Name="ImagesItemsControl" VerticalAlignment="Center" AllowDrop="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="120" Margin="8,6,8,6">
                                        <!-- Hoja de papel vertical (aprox. A4) -->
                                        <Border x:Name="ItemCardBorder"
                                                Width="120" Height="160"
                                                CornerRadius="10"
                                                Background="#F2F2F2"
                                                BorderBrush="#45FFFFFF"
                                                BorderThickness="1"
                                                AllowDrop="True"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                PreviewMouseLeftButtonDown="ItemCard_PreviewMouseLeftButtonDown"
                                                MouseMove="ItemCard_MouseMove"
                                                DragEnter="ItemCard_DragEnter"
                                                DragOver="ItemCard_DragOver"
                                                DragLeave="ItemCard_DragLeave"
                                                Drop="ItemCard_Drop">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.4"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       Width="118" Height="158"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,118,158" RadiusX="9" RadiusY="9"/>
                                                    </Image.Clip>
                                                </Image>

                                                <!-- Insignia de número de página -->
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Margin="7,7,0,0"
                                                        MinWidth="22" Height="20"
                                                        CornerRadius="10"
                                                        Background="#99000000"
                                                        BorderBrush="#40FFFFFF"
                                                        BorderThickness="0.8"
                                                        Padding="7,0"
                                                        IsHitTestVisible="False">
                                                    <TextBlock Text="{Binding PageNumber}"
                                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                                               FontWeight="Bold"
                                                               FontSize="11"
                                                               Foreground="#FFFFFF"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Controles visibles solo al pasar el ratón -->
                                                <Grid x:Name="HoverLayer" Visibility="Collapsed">
                                                    <Border Background="#33000000" CornerRadius="9" IsHitTestVisible="False"/>
                                                    <Button Content="✕"
                                                            Tag="{Binding}"
                                                            ToolTip="Quitar imagen de la lista"
                                                            Style="{StaticResource CardFloatBtnStyle}"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,6,6,0"
                                                            Click="RemoveItemButton_Click"/>
                                                    <Button Content="◀"
                                                            Tag="{Binding}"
                                                            ToolTip="Mover antes"
                                                            Style="{StaticResource CardFloatBtnStyle}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Margin="5,0,0,0"
                                                            Click="MoveUpButton_Click"/>
                                                    <Button Content="▶"
                                                            Tag="{Binding}"
                                                            ToolTip="Mover después"
                                                            Style="{StaticResource CardFloatBtnStyle}"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Margin="0,0,5,0"
                                                            Click="MoveDownButton_Click"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Nombre del archivo -->
                                        <TextBlock Text="{Binding ShortFileName}"
                                                   ToolTip="{Binding FilePath}"
                                                   Margin="0,8,0,0"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="11"
                                                   Foreground="#F2FFFFFF"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Effect="{StaticResource TextReadShadow}"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="ItemCardBorder" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Estado / atajos -->
                <TextBlock x:Name="HintStatusText"
                           Grid.Row="3"
                           Text="Esc: Cancelar · Enter: Crear PDF"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="10.5"
                           Foreground="#B3FFFFFF"
                           Effect="{StaticResource TextReadShadow}"
                           Margin="2,10,0,0"/>

                <!-- Barra inferior: nombre del PDF integrado + Cancelar (fantasma) + Crear PDF (acento) -->
                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="OutputBoxBorder"
                            Grid.Column="0"
                            Height="36"
                            CornerRadius="12"
                            Background="#4D141016"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📄" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox x:Name="OutputFileNameTextBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0,10,0"
                                     FontFamily="Segoe UI Variable Text, Segoe UI"
                                     FontSize="12"
                                     Foreground="#FFFFFF"
                                     CaretBrush="#FFFFFF"
                                     SelectionBrush="#80FFFFFF"/>
                        </Grid>
                    </Border>

                    <Border x:Name="MarginSelectorBorder"
                            Grid.Column="1"
                            Height="36"
                            CornerRadius="12"
                            Background="#4D141016"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            Padding="3,0"
                            Margin="0,0,12,0"
                            ToolTip="Margen alrededor de cada imagen en el PDF">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="Sin borde" Tag="0" GroupName="PdfMargin" IsChecked="True" Style="{StaticResource MarginPillStyle}" Checked="MarginRadio_Checked"/>
                            <RadioButton Content="Delgado" Tag="24" GroupName="PdfMargin" Style="{StaticResource MarginPillStyle}" Checked="MarginRadio_Checked"/>
                            <RadioButton Content="Medio" Tag="48" GroupName="PdfMargin" Style="{StaticResource MarginPillStyle}" Checked="MarginRadio_Checked"/>
                            <RadioButton Content="Amplio" Tag="72" GroupName="PdfMargin" Style="{StaticResource MarginPillStyle}" Checked="MarginRadio_Checked"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="2"
                            Content="Cancelar"
                            IsCancel="True"
                            Style="{StaticResource FooterGlassButtonStyle}"
                            Background="Transparent"
                            BorderBrush="#66FFFFFF"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click"/>

                    <Button x:Name="CreatePdfButton"
                            Grid.Column="3"
                            Content="Crear PDF"
                            IsDefault="True"
                            Style="{StaticResource FooterGlassButtonStyle}"
                            Background="#FFDB2777"
                            BorderBrush="#66FFFFFF"
                            Click="CreatePdfButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
