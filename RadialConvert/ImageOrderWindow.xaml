<Window x:Class="RadialConvert.ImageOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RadialConvert"
        mc:Ignorable="d"
        Title="Organizar páginas del PDF"
        Width="480" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <DropShadowEffect x:Key="ModalDropShadow"
                          BlurRadius="32"
                          ShadowDepth="6"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.55"/>

        <DropShadowEffect x:Key="TextReadShadow"
                          BlurRadius="4"
                          ShadowDepth="1"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.7"/>

        <!-- Bisel especular estilo Liquid Glass -->
        <LinearGradientBrush x:Key="SpecularBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B3FFFFFF" Offset="0.0"/>
            <GradientStop Color="#59FFFFFF" Offset="0.5"/>
            <GradientStop Color="#26FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Estilo de botones pequeños de control (▲, ▼, ✕) -->
        <Style x:Key="MiniGlassActionBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#66FFFFFF"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#88FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botones inferiores ("Cancelar" y "Crear PDF") -->
        <Style x:Key="FooterGlassButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FooterBtnBorder"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Effect="{StaticResource TextReadShadow}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterBtnBorder" Property="BorderBrush" Value="#FFFFFFFF"/>
                                <Setter TargetName="FooterBtnBorder" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FooterBtnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Contenedor principal con margen para la sombra exterior -->
    <Grid Margin="18">
        <Border x:Name="MainGlassBorder"
                CornerRadius="22"
                BorderBrush="{StaticResource SpecularBorderBrush}"
                BorderThickness="1.5"
                Effect="{StaticResource ModalDropShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                    <GradientStop Color="#CCFCE7F3" Offset="0.0"/>
                    <GradientStop Color="#B3F472B6" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="18,16,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado arrastrable -->
                <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📑" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TitleTextBlock"
                                   Text="Organizar páginas del PDF (0 imágenes)"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontWeight="SemiBold"
                                   FontSize="14.5"
                                   Foreground="#FFFFFF"
                                   Effect="{StaticResource TextReadShadow}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="✕"
                            Style="{StaticResource MiniGlassActionBtnStyle}"
                            ToolTip="Cancelar (Esc)"
                            Click="CancelButton_Click"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="Arrastra una tarjeta o usa las flechas ▲ / ▼ para cambiar el orden de las páginas:"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11"
                           Foreground="#E6FFFFFF"
                           Effect="{StaticResource TextReadShadow}"
                           Margin="0,6,0,10"/>

                <!-- Lista de tarjetas de imágenes con Scroll suave y soporte Drag & Drop -->
                <Border x:Name="ListContainerBorder"
                        Grid.Row="2"
                        CornerRadius="14"
                        Background="#4D141016"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <ItemsControl x:Name="ImagesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ItemCardBorder"
                                            CornerRadius="11"
                                            Background="#59221A20"
                                            BorderBrush="#45FFFFFF"
                                            BorderThickness="1"
                                            Margin="0,0,0,7"
                                            Padding="8,6"
                                            AllowDrop="True"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            PreviewMouseLeftButtonDown="ItemCard_PreviewMouseLeftButtonDown"
                                            MouseMove="ItemCard_MouseMove"
                                            DragEnter="ItemCard_DragEnter"
                                            DragLeave="ItemCard_DragLeave"
                                            Drop="ItemCard_Drop">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Miniatura de la imagen -->
                                            <Border Grid.Column="0"
                                                    Width="44" Height="44"
                                                    CornerRadius="7"
                                                    Background="#40000000"
                                                    BorderBrush="#55FFFFFF"
                                                    BorderThickness="1"
                                                    ClipToBounds="True"
                                                    HorizontalAlignment="Left">
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>

                                            <!-- Nombre corto y etiqueta de posición (Pág. 1, Pág. 2...) -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,8,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <Border CornerRadius="5"
                                                            Background="#66F472B6"
                                                            BorderBrush="#80FFFFFF"
                                                            BorderThickness="0.8"
                                                            Padding="6,1"
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding PageLabel}"
                                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                                   FontWeight="Bold"
                                                                   FontSize="10"
                                                                   Foreground="#FFFFFF"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DimensionsLabel}"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="10"
                                                               Foreground="#CCFFFFFF"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding ShortFileName}"
                                                           ToolTip="{Binding FilePath}"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="#FFFFFF"
                                                           TextTrimming="CharacterEllipsis"
                                                           Effect="{StaticResource TextReadShadow}"/>
                                            </StackPanel>

                                            <!-- Controles para subir, bajar o quitar imagen -->
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="▲"
                                                        Tag="{Binding}"
                                                        ToolTip="Subir página"
                                                        Style="{StaticResource MiniGlassActionBtnStyle}"
                                                        Click="MoveUpButton_Click"/>
                                                <Button Content="▼"
                                                        Tag="{Binding}"
                                                        ToolTip="Bajar página"
                                                        Style="{StaticResource MiniGlassActionBtnStyle}"
                                                        Click="MoveDownButton_Click"/>
                                                <Button Content="✕"
                                                        Tag="{Binding}"
                                                        ToolTip="Quitar imagen de la lista"
                                                        Style="{StaticResource MiniGlassActionBtnStyle}"
                                                        Background="#59B91C1C"
                                                        BorderBrush="#80FCA5A5"
                                                        Margin="6,0,0,0"
                                                        Click="RemoveItemButton_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Campo de nombre del archivo de salida -->
                <Grid Grid.Row="3" Margin="0,10,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Archivo PDF:"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontWeight="SemiBold"
                               FontSize="11.5"
                               Foreground="#FFFFFF"
                               Effect="{StaticResource TextReadShadow}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="OutputFileNameTextBox"
                             Grid.Column="1"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             FontFamily="Segoe UI Variable Text, Segoe UI"
                             FontSize="11.5"
                             Foreground="#FFFFFF"
                             CaretBrush="#FFFFFF"
                             Background="#4D141016"
                             BorderBrush="#66FFFFFF"
                             BorderThickness="1"/>
                </Grid>

                <!-- Barra inferior: Cancelar (Esc) y Crear PDF (Enter) -->
                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="HintStatusText"
                               Grid.Column="0"
                               Text="Esc: Cancelar · Enter: Crear PDF"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="10.5"
                               Foreground="#D9FFFFFF"
                               Effect="{StaticResource TextReadShadow}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Cancelar"
                            IsCancel="True"
                            Style="{StaticResource FooterGlassButtonStyle}"
                            Background="#401F121A"
                            BorderBrush="#66FFFFFF"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click"/>

                    <Button x:Name="CreatePdfButton"
                            Grid.Column="2"
                            Content="Crear PDF"
                            IsDefault="True"
                            Style="{StaticResource FooterGlassButtonStyle}"
                            Background="#B3DB2777"
                            BorderBrush="#FFFFFFFF"
                            Click="CreatePdfButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

